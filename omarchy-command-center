def slug(name: str) -> str:
    s = re.sub(r"[^A-Za-z0-9-]+", "-", str(name)).strip("-")
    if not s or s[0].isdigit():
        s = f"x-{s}" if s else "x"
    return s


def plugin_entries() -> list[dict]:
    entries = []
    if not PLUGINS_DIR.is_dir():
        return entries
    for d in sorted(PLUGINS_DIR.iterdir()):
        if not d.is_dir():
            continue
        meta = {}
        mf = d / "manifest.json"
        if mf.exists():
            try:
                meta = json.loads(mf.read_text())
            except Exception:
                meta = {}
        entries.append({"id": d.name, "dir": d, "meta": meta})
    return entries


def plugin_enabled(pid: str) -> bool:
    data = shell_data()
    if pid in (data.get("plugins") or []):
        return True
    for section in (data.get("bar") or {}).get("layout", {}).values():
        for w in section or []:
            if isinstance(w, dict) and w.get("id") == pid:
                return True
    return False


def hook_entries() -> list[dict]:
    entries = []
    if not HOOKS_DIR.is_dir():
        return entries
    for d in sorted(HOOKS_DIR.glob("*.d")):
        for f in sorted(d.iterdir()):
            if not f.is_file():
                continue
            entries.append({"path": f, "event": d.name, "name": f.name, "active": not f.name.endswith(".sample")})
    return entries


def default_value(kind: str) -> str:
    f = DEFAULTS_DIR / kind
    try:
        return f.read_text().strip()
    except Exception:
        return ""


def build_hypr_rows() -> tuple[tuple[str, str], list, set, bool]:
    out = sh(["omarchy", "menu", "keybindings", "--print"])
    rows = []
    for line in out.splitlines():
        if "\u2192" not in line:
            continue
        key, desc = (p.strip() for p in line.split("\u2192", 1))
        rows.append([key, desc])
    overrides = set()
    defaults_off = False
    if HYPR_BINDINGS.exists():
        for line in HYPR_BINDINGS.read_text().splitlines():
            s = line.strip()
            if not s or s.startswith("--"):
                continue
            if "omarchy_default_bindings = false" in s:
                defaults_off = True
            m = re_search(r'o\.bind\(\s*"([^"]+)"', s) or re_search(r'hl\.unbind\(\s*"([^"]+)"', s)
            if m:
                overrides.add(m)
    marked = []
    for row in rows:
        if row[0] in overrides:
            marked.append([row[0], row[1] + "   [user override]"])
        else:
            marked.append(row)
    return ("Key Binding", "Description"), marked, overrides, defaults_off


def _hbind_key(line: str) -> Optional[str]:
    s = line.strip()
    if not s or s.startswith("--"):
        return None
    m = re.search(r"\b(?:o\.bind|hl\.unbind)\(\s*\"([^\"]+)\"", s)
    return m.group(1) if m else None


def hypr_overrides_map() -> dict[str, tuple[str, str]]:
    overrides = {}
    if not HYPR_BINDINGS.is_file():
        return overrides
    for line in HYPR_BINDINGS.read_text().splitlines():
        m = re.search(
            r'o\.bind\(\s*"([^"]+)"\s*,\s*(?:nil|"((?:[^"\\]|\\.)*)")\s*,\s*"((?:[^"\\]|\\.)*)"',
            line,
        )
        if m:
            overrides[m.group(1)] = (_unlua_str(m.group(2) or ""), _unlua_str(m.group(3)))
    return overrides


def _unlua_str(s: str) -> str:
    return s.replace('\\"', '"').replace("\\\\", "\\")


def _lua_str(s: str) -> str:
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _write_hypr_bindings(body: str) -> None:
    backup(HYPR_BINDINGS)
    HYPR_BINDINGS.write_text(body.rstrip() + "\n")


def hypr_write_change(old_key: str, new_key: str, description: str, command: str, default_keys: set) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        key = _hbind_key(ln)
        if key is not None and key in (old_key, new_key):
            continue
        lines.append(ln)
    kept = "\n".join(lines).rstrip()
    additions = []
    if new_key in default_keys:
        additions.append(f'hl.unbind("{new_key}")')
    desc = f'"{_lua_str(description)}"' if description else "nil"
    additions.append(f'o.bind("{new_key}", {desc}, "{_lua_str(command)}")')
    body = kept + "\n" + "\n".join(additions) if kept else "\n".join(additions)
    _write_hypr_bindings(body)


def hypr_write_unbind(key: str) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        matched = _hbind_key(ln)
        if matched is not None and matched == key:
            continue
        lines.append(ln)
    kept = "\n".join(lines).rstrip()
    body = kept + "\n" + f'hl.unbind("{key}")' if kept else f'hl.unbind("{key}")'
    _write_hypr_bindings(body)


def hypr_write_revert(key: str) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        matched = _hbind_key(ln)
        if matched is not None and matched == key:
            continue
        lines.append(ln)
    _write_hypr_bindings("\n".join(lines).rstrip())


def re_search(pattern: str, text: str) -> Optional[str]:
    m = re.search(pattern, text)
    return m.group(1) if m else None


def build_tmux_rows() -> list:
    if not TMUX_CONF.exists():
        return []
    rows = []
    for line in TMUX_CONF.read_text().splitlines():
        s = line.strip()
        if not s.startswith("bind "):
            continue
        m = re.match(r'bind\s+(?:-N\s+"(?P<desc>[^"]*)"\s+)?(?P<rest>.+)$', s)
        if not m:
            continue
        desc = (m.group("desc") or "").strip()
        toks = m.group("rest").split()
        i = 0
        while i < len(toks) and toks[i].startswith("-"):
            if toks[i] == "-T" and i + 1 < len(toks):
                i += 2
            elif toks[i] in ("-t", "-b", "-g") and i + 1 < len(toks):
                i += 2
            else:
                i += 1
        if i >= len(toks):
            continue
        key = toks[i]
        cmd = " ".join(toks[i + 1 :])
        if not desc:
            desc = cmd
        rows.append([key, desc, cmd])
    return rows


def build_herdr_rows() -> list:
    if not HERDR_CONF.exists():
        return []
    try:
        data = tomllib.loads(HERDR_CONF.read_text())
    except Exception:
        return []
    rows = []
    for name, val in (data.get("keys") or {}).items():
        if isinstance(val, list):
            combo = ", ".join(val)
        else:
            combo = str(val)
        desc = name.replace("_", " ").capitalize()
        rows.append([desc, combo])
    return rows


def build_nvim_rows() -> list:
    if not NVIM_KEYMAPS.exists():
        return []
    rows = []
    for line in NVIM_KEYMAPS.read_text().splitlines():
        m = re.search(
            r'vim\.keymap\.set\(\s*["\']([^"\']+)["\']\s*,\s*["\']([^"\']+)["\']\s*,\s*["\'](.*?)["\']', line
        )
        if not m:
            continue
        mode, key, cmd = m.groups()
        dm = re.search(r'desc\s*=\s*["\']([^"\']+)["\']', line)
        purpose = dm.group(1) if dm else cmd
        rows.append([mode, key, cmd, purpose])
    return rows


class DashboardView(VerticalScroll):
    def compose(self) -> ComposeResult:
        yield Static("", id="dash-stats", classes="stat")
        yield Horizontal(
            Vertical(
                Label("Plugins", classes="section-title"),
                OptionList(id="dash-plugins"),
            ),
            Vertical(
                Label("Hooks", classes="section-title"),
                OptionList(id="dash-hooks"),
            ),
            classes="pads",
        )
        yield Horizontal(Button("Refresh", id="dash-refresh", variant="primary"), classes="buttons-row")

    @on(Button.Pressed, "#dash-refresh")
    def _refresh_clicked(self) -> None:
        self.refresh_view()

    def on_mount(self) -> None:
        self.refresh_view()

    def refresh_view(self) -> None:
        self.notify("Refreshing dashboard…", timeout=2)
        version = sh(["omarchy", "version"]) or "unknown"
        theme = active_theme() or "unknown"
        bg = sh(["omarchy", "theme", "bg", "current"]) or "–"
        check = sh(["omarchy", "commands", "--check"])
        if not check:
            check_status = "unavailable"
        elif "failed" in check.lower():
            check_status = check.splitlines()[0].strip()[:30]
        else:
            check_status = "OK"

        data = shell_data()
        bar = data.get("bar") or {}
        layout = bar.get("layout") or {}
        idle = data.get("idle") or {}
        position = bar.get("position", "top")
        transparent = "yes" if bar.get("transparent") else "no"
        anchor = bar.get("centerAnchor", "–")
        lock = idle.get("lock", "–")
        ssaver = idle.get("screensaver", "–")

        themes = theme_dirs()
        user_count = sum(1 for t in themes if t["user"])
        builtin_count = len(themes) - user_count
        plugins = plugin_entries()
        hooks = hook_entries()
        active_hooks = sum(1 for h in hooks if h["active"])

        defaults = [f"{k}={default_value(k) or '–'}" for k in DEFAULTS]
        hook_summary = f"{active_hooks} active · {len(hooks) - active_hooks} samples" if hooks else "none"

        commands = [
            ("Version", version),
            ("Active theme", theme),
            ("Background", bg),
            ("Bar position", position),
            ("Bar transparent", transparent),
            ("Clock anchor", anchor),
            ("Idle lock / screensaver", f"{lock}s / {ssaver}s"),
            ("Default agent", default_value("agent") or "–"),
            ("Defaults", ", ".join(defaults)),
            ("Themes", f"{user_count} user · {builtin_count} built-in"),
            ("Plugins", f"{len(plugins)} installed · {sum(plugin_enabled(p['id']) for p in plugins)} enabled"),
            ("Hooks", hook_summary),
            ("Commands check", check_status),
        ]
        lines = [f"[b {PALETTE['accent']}]OMARCHY SYSTEM[/]", ""]
        for label, value in commands:
            lines.append(f"[b {PALETTE['muted']}]{label:<24}[/] {value}")
        self.query_one("#dash-stats", Static).update("\n".join(lines))

        plist = self.query_one("#dash-plugins", OptionList)
        plist.clear_options()
        plist.add_options(
            [
                Option(("● " if plugin_enabled(p["id"]) else "○ ") + p["id"], id=f"dp-{slug(p['id'])}")
                for p in plugins
            ]
        )
        hlist = self.query_one("#dash-hooks", OptionList)
