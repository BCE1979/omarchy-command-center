        else:
            self.notify(f"Failed: {err.strip() or out.strip()}", severity="error")

    @on(OptionList.OptionHighlighted, "#term-list")
    def _highlight(self, ev: OptionList.OptionHighlighted) -> None:
        self._detail(ev.option_index)

    def refresh_view(self) -> None:
        self.terminals = [t for t in TERMINAL_CONFS if shutil.which(t)]
        ol = self.query_one("#term-list", OptionList)
        ol.clear_options()
        detected = self.terminals
        ol.add_options(
            [
                Option(("● " if t in detected else "○ ") + t, id=f"term-{slug(t)}")
                for t in self.all_terms
            ]
        )
        current = default_value("terminal") or "(unset — xdg-terminal-exec)"
        self.query_one("#term-current", Static).update(f"[b {ACCENT}]Default[/]  {current}")

        installed = ", ".join(detected) or "none detected"
        self.query_one("#term-detected", Static).update(f"[b]Detected[/]  {installed}")
        if self.terminals:
            self._detail(0)

    def _detail(self, idx: int) -> None:
        if not (0 <= idx < len(self.all_terms)):
            return
        name = self.all_terms[idx]
        self.query_one("#term-path", Static).update(f"[b {STEEL}]Config[/]  {TERMINAL_CONFS[name]}")
        detail = []
        path = TERMINAL_CONFS[name]
        if not path.exists():
            detail.append(f"[{STEEL}]not present[/]")
        else:
            detail.append(f"[{STEEL}]size {path.stat().st_size} bytes[/]")
            for line in path.read_text().splitlines():
                s = line.strip()
                if s.startswith("include") or s.startswith("import") or s.startswith("source"):
                    detail.append(f"[{ACCENT}]themed via:[/] {s}")
                elif s and not s.startswith("#"):
                    first = s[:72]
                    try:
                        detail.append(first)
                    except Exception:
                        pass
                    break
        self.query_one("#term-detail", Static).update("\n".join(detail))


class PluginsView(Vertical):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.plugins: list[dict] = []

    def compose(self) -> ComposeResult:
        with Horizontal(classes="pads"):
            yield Vertical(
                Label("Plugins", classes="section-title"),
                OptionList(id="plugin-list"),
                Horizontal(
                    Button("Toggle enable", id="plugin-toggle"),
                    Button("Open folder", id="plugin-open"),
                    Button("Refresh", id="plugin-refresh"),
                    classes="buttons-row",
                ),
                classes="col",
            )
            yield Vertical(
                Label("Details", classes="section-title"),
                Static("", id="plugin-name", classes="stat"),
                Static("", id="plugin-meta", classes="hint"),
                Static("", id="plugin-desc", classes="hint"),
                classes="col",
            )

    def on_mount(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#plugin-refresh")
    def _refresh(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#plugin-open")
    def _open(self) -> None:
        idx = self.query_one("#plugin-list", OptionList).highlighted
        if idx is not None and 0 <= idx < len(self.plugins):
            run(["xdg-open", str(self.plugins[idx]["dir"])])

    @on(Button.Pressed, "#plugin-toggle")
    def _toggle(self) -> None:
        ol = self.query_one("#plugin-list", OptionList)
        idx = ol.highlighted
        if idx is None or not (0 <= idx < len(self.plugins)):
            self.notify("Select a plugin first", severity="warning")
            return
        pid = self.plugins[idx]["id"]
        data = shell_data()
        plist = list(data.get("plugins") or [])
        enabled = plugin_enabled(pid)
        if enabled:
            self.notify(f"No-op: {pid} is a bar widget — remove it in the Bar screen to disable")
            if pid in plist:
                plist.remove(pid)
                data["plugins"] = plist
                write_json(SHELL_JSON, data, backup=True)
        else:
            if pid not in plist:
                plist.append(pid)
                data["plugins"] = plist
                write_json(SHELL_JSON, data, backup=True)
            self.notify(f"Registered {pid} in shell.json plugins (add its widget in Bar to show it)")
        self.refresh_view()

    @on(OptionList.OptionHighlighted, "#plugin-list")
    def _highlight(self, ev: OptionList.OptionHighlighted) -> None:
        self._detail(ev.option_index)

    def refresh_view(self) -> None:
        self.plugins = plugin_entries()
        ol = self.query_one("#plugin-list", OptionList)
        ol.clear_options()
        for p in self.plugins:
            state = "● " if plugin_enabled(p["id"]) else "○ "
            ol.add_options([Option(state + p["id"], id=f"pl-{slug(p['id'])}")])
        if self.plugins:
            self._detail(0)

    def _detail(self, idx: int) -> None:
        if not (0 <= idx < len(self.plugins)):
            return
        p = self.plugins[idx]
        meta = p["meta"]
        state = "enabled" if plugin_enabled(p["id"]) else "disabled"
        self.query_one("#plugin-name", Static).update(
            f"[b {ACCENT}]{p['id']}[/]  [i]{state}[/]"
        )
        lines = []
        for key in ("name", "version", "author", "kinds", "description"):
            if meta.get(key):
                lines.append(f"[b {STEEL}]{key}[/] {meta[key]}")
        if meta.get("barWidget"):
            bw = meta["barWidget"]
            lines.append(f"[b {STEEL}]bar[/] {bw.get('displayName','')} — {bw.get('description','')}")
        if meta.get("omarchy"):
            lines.append(f"[b {STEEL}]omarchy[/] {meta['omarchy']}")
        self.query_one("#plugin-meta", Static).update("\n".join(lines) if lines else "[i]no manifest.json[/]")
        self.query_one("#plugin-desc", Static).update(f"dir: {p['dir']}")


class HooksView(VerticalScroll):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.hooks: list[dict] = []

    def compose(self) -> ComposeResult:
        with Horizontal(classes="pads"):
            yield Vertical(
                Label("Lifecycle hooks (dir/file)", classes="section-title"),
                OptionList(id="hook-list"),
                Horizontal(
                    Button("Toggle on/off", id="hook-toggle", variant="primary"),
                    Button("Refresh", id="hook-refresh"),
                    classes="buttons-row",
                ),
                classes="col",
            )
            yield Vertical(
                Label("Contents", classes="section-title"),
                Static("", id="hook-path", classes="hint"),
                Static("", id="hook-content", classes="stat"),
                classes="col",
            )

    def on_mount(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#hook-refresh")
    def _refresh(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#hook-toggle")
    def _toggle(self) -> None:
        ol = self.query_one("#hook-list", OptionList)
        idx = ol.highlighted
        if idx is None or not (0 <= idx < len(self.hooks)):
            self.notify("Select a hook first", severity="warning")
            return
        h = self.hooks[idx]
        path = h["path"]
        if h["active"]:
            new = path.with_name(path.name + ".sample")
        else:
            new = path.with_name(path.name.removesuffix(".sample"))
        try:
            path.rename(new)
            self.notify(f"{'Disabled' if h['active'] else 'Enabled'}: {h['name']}")
        except Exception as exc:
            self.notify(f"Failed: {exc}", severity="error")
        self.refresh_view()

    @on(OptionList.OptionHighlighted, "#hook-list")
    def _highlight(self, ev: OptionList.OptionHighlighted) -> None:
        self._detail(ev.option_index)

    def refresh_view(self) -> None:
        self.hooks = hook_entries()
        ol = self.query_one("#hook-list", OptionList)
        ol.clear_options()
        for h in self.hooks:
            state = "● " if h["active"] else "○ "
            ol.add_options(
                [Option(state + f"{h['event']}/{h['name']}", id=f"hk-{slug(h['path'].stem)}")]
            )
        if self.hooks:
            self._detail(0)

    def _detail(self, idx: int) -> None:
        if not (0 <= idx < len(self.hooks)):
            return
        h = self.hooks[idx]
        self.query_one("#hook-path", Static).update(str(h["path"]))
        content = h["path"].read_text(errors="replace")
        lines = content.splitlines()
        preview = "\n".join(lines if len(lines) <= 40 else lines[:40] + ["… (truncated)"])
        self.query_one("#hook-content", Static).update(preview if preview.strip() else "[i]empty[/]")


class DefaultsView(VerticalScroll):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.kinds = list(DEFAULTS)

    def compose(self) -> ComposeResult:
        yield Static(
            f"Values are written via `omarchy default <kind> <value>` into ~/.config/omarchy/defaults.",
            classes="hint",
        )
        for kind in self.kinds:
            with Horizontal(classes="defaults-row"):
                yield Label(kind, classes="kind-label")
                yield Input(id=f"def-{kind}", placeholder=", ".join(DEFAULTS[kind]))
                yield Button("Apply", id=f"def-apply-{kind}")

    def on_mount(self) -> None:
        self.refresh_view()

    @on(Button.Pressed)
    def _apply(self, ev: Button.Pressed) -> None:
        if not ev.button.id or not ev.button.id.startswith("def-apply-"):
            return
        kind = ev.button.id.removeprefix("def-apply-")
        value = self.query_one(f"#def-{kind}", Input).value.strip()
        candidates = DEFAULTS.get(kind, [])
        if not value:
            self.notify("Enter a value first", severity="warning")
            return
        if candidates and value not in candidates:
            self.notify(
                f"{value} is not a known {kind} ({', '.join(candidates)})",
                severity="warning",
                timeout=5,
            )
            return
        out, err, code = run(["omarchy", "default", kind, value])
        if code == 0:
            self.notify(f"Default {kind} → {value}")
        else:
            self.notify(f"Failed: {err.strip() or out.strip()}", severity="error")
        self.refresh_view()

    def refresh_view(self) -> None:
        for kind in self.kinds:
            self.query_one(f"#def-{kind}", Input).value = default_value(kind)


class OmarchyCommandCenter(App):
    TITLE = "Omarchy Command Center"
    BINDINGS = [
        Binding("f1", "goto_dashboard", "Dashboard", show=True),
        Binding("f2", "goto_themes", "Themes", show=True),
        Binding("f3", "goto_bar", "Bar", show=True),
        Binding("f4", "goto_keybindings", "Keybindings", show=True),
        Binding("f5", "goto_terminals", "Terminals", show=True),
        Binding("f6", "goto_plugins", "Plugins", show=True),
        Binding("f7", "goto_hooks", "Hooks", show=True),
        Binding("f8", "goto_defaults", "Defaults", show=True),
        Binding("1", "goto_dashboard", "Dashboard", show=False),
        Binding("2", "goto_themes", "Themes", show=False),
        Binding("3", "goto_bar", "Bar", show=False),
        Binding("4", "goto_keybindings", "Keybindings", show=False),
        Binding("5", "goto_terminals", "Terminals", show=False),
        Binding("6", "goto_plugins", "Plugins", show=False),
        Binding("7", "goto_hooks", "Hooks", show=False),
        Binding("8", "goto_defaults", "Defaults", show=False),
        Binding("r", "refresh_current", "Refresh", show=True),
        Binding("q", "quit", "Quit", show=True, priority=True),
    ]
    VIEWS = [
        ("dashboard", "Dashboard"),
        ("themes", "Themes"),
        ("bar", "Bar"),
        ("keybindings", "Keybindings"),
        ("terminals", "Terminals"),
        ("plugins", "Plugins"),
        ("hooks", "Hooks"),
        ("defaults", "Defaults"),
    ]

    def __init__(self):
        super().__init__()
        self._version = sh(["omarchy", "version"]) or "?"
        self._apply_theme_css()

    def _apply_theme_css(self) -> None:
        global PALETTE, ACCENT, STEEL, FG
        PALETTE = build_palette()
        ACCENT = PALETTE["accent"]
        STEEL = PALETTE["dark_foreground"]
        FG = PALETTE["light_foreground"]
        self.stylesheet.add_source(app_css(PALETTE), read_from=("", "occ-css"))
        if self._is_mounted:
            self.refresh_css()

    def compose(self) -> ComposeResult:
        with Horizontal(id="brand"):
            yield Static(f"OMARCHY  COMMAND CENTER", id="brand-title")
            yield Static(f"v{self._version}", id="brand-meta")
        with Horizontal(id="body"):
            yield OptionList(
                *[
                    Option(f"{i + 1}: {label}", id=vid)
                    for (vid, label), i in zip(self.VIEWS, range(len(self.VIEWS)))
                ],
                id="sidebar",
            )
            with ContentSwitcher(id="view-switcher"):
                yield DashboardView(id="dashboard")
                yield ThemesView(id="themes")
                yield BarView(id="bar")
                yield KeybindingsView(id="keybindings")
                yield TerminalsView(id="terminals")
                yield PluginsView(id="plugins")
                yield HooksView(id="hooks")
                yield DefaultsView(id="defaults")
        yield Footer()

    def on_mount(self) -> None:
        self.query_one("#view-switcher", ContentSwitcher).current = "dashboard"
        try:
            self.query_one("#sidebar", OptionList).highlighted = 0
        except Exception:
            pass

    @on(OptionList.OptionSelected, "#sidebar")
    def _nav(self, ev: OptionList.OptionSelected) -> None:
        self._show(str(ev.option_id))

    def _show(self, view_id: str) -> None:
        switcher = self.query_one("#view-switcher", ContentSwitcher)
        if view_id not in {c.id for c in switcher.children}:
            return
        switcher.current = view_id
        widget = self.query_one(f"#{view_id}")
        if hasattr(widget, "refresh_view"):
            widget.refresh_view()
        try:
            ol = self.query_one("#sidebar", OptionList)
            for i, (vid, _label) in enumerate(self.VIEWS):
                if vid == view_id:
                    ol.highlighted = i
                    break
        except Exception:
            pass

    def action_goto_dashboard(self) -> None:
        self._show("dashboard")

    def action_goto_themes(self) -> None:
        self._show("themes")

    def action_goto_bar(self) -> None:
        self._show("bar")

    def action_goto_keybindings(self) -> None:
        self._show("keybindings")

    def action_goto_terminals(self) -> None:
        self._show("terminals")

    def action_goto_plugins(self) -> None:
        self._show("plugins")

    def action_goto_hooks(self) -> None:
        self._show("hooks")

    def action_goto_defaults(self) -> None:
        self._show("defaults")

    def action_refresh_current(self) -> None:
        current = self.query_one("#view-switcher", ContentSwitcher).current
        widget = self.query_one(f"#{current}")
        if hasattr(widget, "refresh_view"):
            widget.refresh_view()


