class KeybindingsView(Vertical):
    TABS = (
        ("hypr", "Hyprland", ("Key Binding", "Description")),
        ("tmux", "Tmux", ("Key", "Description", "Command")),
        ("herdr", "Herdr", ("Setting", "Combo")),
        ("nvim", "Neovim", ("Mode", "Key", "Command", "Purpose")),
    )
    NOTES = {
        "hypr": "Defaults from `omarchy menu keybindings --print`. User overrides live in ~/.config/hypr/bindings.lua — flagged in rows.",
        "tmux": "Parsed from ~/.config/tmux/tmux.conf. Herdr mirrors these mappings; see the Herdr tab.",
        "herdr": "Parsed from ~/.config/herdr/config.toml [keys]. Mirrors the tmux bindings in workspace/tab/pane terms.",
        "nvim": "Parsed from ~/.config/nvim/lua/config/keymaps.lua. LazyVim defaults apply unless overridden here.",
    }

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.rows: dict[str, list] = {}
        self.hypr_overrides: set = set()
        self.hypr_defaults_off = False
        self.hypr_default_keys: set = set()
        self.hypr_override_map: dict[str, tuple[str, str]] = {}
        self._hypr_display: list = []

    def compose(self) -> ComposeResult:
        with TabbedContent():
            for tab, label, _cols in self.TABS:
                with TabPane(label, id=f"pane-{tab}"):
                    yield Static(self.NOTES[tab], id=f"kb-note-{tab}", classes="hint")
                    yield Input(id=f"kb-search-{tab}", classes="search", placeholder="Search…")
                    yield Static("", id=f"kb-info-{tab}", classes="hint")
                    if tab == "hypr":
                        yield KbDataTable(id=f"kb-table-{tab}", cursor_type="row")
                    else:
                        yield DataTable(id=f"kb-table-{tab}", cursor_type="row")
        yield Horizontal(
            Button("Edit…", id="kb-edit", variant="primary"),
            Button("Unbind", id="kb-unbind"),
            Button("Refresh", id="kb-refresh"),
            classes="buttons-row",
        )

    def on_mount(self) -> None:
        self.refresh_view()
        self._set_hypr_edit(True)

    def _hypr_active(self) -> bool:
        try:
            return str(self.query_one(TabbedContent).active) in ("pane-hypr", "hypr")
        except Exception:
            return True

    def _set_hypr_edit(self, hypr: bool) -> None:
        try:
            self.query_one("#kb-edit", Button).disabled = not hypr
            self.query_one("#kb-unbind", Button).disabled = not hypr
        except Exception:
            pass

    @on(TabbedContent.TabActivated)
    def _tab_activated(self, ev: TabbedContent.TabActivated) -> None:
        self._set_hypr_edit(getattr(ev.pane, "id", "") == "pane-hypr")

    def refresh_view(self) -> None:
        cols, rows, overrides, defaults_off = build_hypr_rows()
        self.rows["hypr"] = rows
        self.rows["tmux"] = build_tmux_rows()
        self.rows["herdr"] = build_herdr_rows()
        self.rows["nvim"] = build_nvim_rows()
        self.hypr_overrides = overrides
        self.hypr_defaults_off = defaults_off
        self.hypr_default_keys = {r[0] for r in rows}
        self.hypr_override_map = hypr_overrides_map()
        for tab, _label, cols_def in self.TABS:
            self.render_table(tab, cols_def)
        if defaults_off:
            self.notify("Hyprland default bindings are all disabled (bindings.lua flag)", timeout=3)

    @on(Button.Pressed, "#kb-edit")
    def _edit(self) -> None:
        if not self._hypr_active():
            return
        self.edit_selected()

    @on(Button.Pressed, "#kb-unbind")
    async def _unbind(self) -> None:
        if not self._hypr_active():
            return
        key = self._selected_key()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        hypr_write_unbind(key)
        self.notify(f"Unbound {key}")
        self.refresh_view()

    @on(Button.Pressed, "#kb-refresh")
    def _refresh(self) -> None:
        self.refresh_view()

    @work
    async def edit_selected(self) -> None:
        if not self._hypr_active():
            return
        key = self._selected_key()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        desc, cmd = self.hypr_override_map.get(key, ("", ""))
        if not desc and self._hypr_display:
            table = self.query_one("#kb-table-hypr", DataTable)
            if 0 <= table.cursor_row < len(self._hypr_display):
                desc = self._hypr_display[table.cursor_row][1].split("  [user override]")[0]
        result = await self.app.push_screen_wait(RebindScreen(key, desc, cmd))
        if not result or result["action"] == "cancel":
            return
        if result["action"] == "unbind":
            hypr_write_unbind(key)
            self.notify(f"Unbound {key}")
        elif result["action"] == "revert":
            hypr_write_revert(key)
            self.notify(f"Restored default for {key}")
        else:
            hypr_write_change(key, result["key"], result["description"], result["command"], self.hypr_default_keys)
            verb = "Changed" if result["key"] == key else "Rebound"
            self.notify(f"{verb} {result['key']} → {result['command']}")
        self.refresh_view()

    def _selected_key(self) -> Optional[str]:
        table = self.query_one("#kb-table-hypr", DataTable)
        if table.cursor_row is None or not (0 <= table.cursor_row < len(self._hypr_display)):
            return None
        return str(self._hypr_display[table.cursor_row][0])

    @on(Input.Changed)
    def _search(self, ev: Input.Changed) -> None:
        if not ev.input.id or not ev.input.id.startswith("kb-search-"):
            return
        tab = ev.input.id.removeprefix("kb-search-")
        cols = next(c for t, _l, c in self.TABS if t == tab)
        self.render_table(tab, cols)

    def render_table(self, tab: str, columns: tuple) -> None:
        query = self.query_one(f"#kb-search-{tab}", Input).value.strip().lower()
        rows = self.rows.get(tab) or []
        table = self.query_one(f"#kb-table-{tab}", DataTable)
        table.clear(columns=True)
        table.add_columns(*columns)
        filtered = [r for r in rows if not query or any(query in str(c).lower() for c in r)]
        if filtered:
            table.add_rows(filtered)
        if tab == "hypr":
            self._hypr_display = filtered
        self.query_one(f"#kb-info-{tab}", Static).update(f"{len(filtered)} of {len(rows)} rows")


