def build_palette() -> dict[str, str]:
    colors = {}
    for t in theme_dirs():
        if theme_names_match(active_theme(), t["name"]):
            colors = theme_colors(t["dir"])
            break
    palette = dict(_HOLMES)
    for key in _HOLMES:
        val = colors.get(key)
        if isinstance(val, str) and val.startswith("#"):
            palette[key] = val
    return palette


