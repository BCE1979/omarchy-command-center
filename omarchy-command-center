def run(cmd: list[str], timeout: int = 90) -> tuple[str, str, int]:
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return res.stdout, res.stderr, res.returncode
    except Exception as exc:
        return "", str(exc), -1


def sh(cmd: list[str]) -> str:
    out, _err, code = run(cmd)
    return out.strip() if code == 0 else ""


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def write_json(path: Path, data: dict, backup: bool = True) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if backup and path.exists():
        bak = path.with_name(f"{path.name}.bak.{int(time.time())}")
        try:
            shutil.copy2(path, bak)
        except Exception:
            pass
        baks = sorted(
            path.parent.glob(f"{path.name}.bak.*"),
            key=lambda p: p.stat().st_mtime if p.exists() else 0,
        )
        for extra in baks[:-5]:
            try:
                extra.unlink()
            except Exception:
                pass
    path.write_text(json.dumps(data, indent=2) + "\n")


def backup(path: Path) -> None:
    if path.exists():
        bak = path.with_name(f"{path.name}.bak.{int(time.time())}")
        try:
            shutil.copy2(path, bak)
        except Exception:
            pass


def luminance(hexcol: str) -> float:
    try:
        r, g, b = (int(hexcol[i : i + 2], 16) / 255 for i in (1, 3, 5))
    except Exception:
        return 0.5
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def color_name(hexcol: str) -> str:
    raw = hexcol.strip().lstrip("#")
    if len(raw) == 3:
        raw = "".join(c * 2 for c in raw)
    try:
        r, g, b = (int(raw[i : i + 2], 16) / 255 for i in (0, 2, 4))
    except Exception:
        return "color"
    mx, mn = max(r, g, b), min(r, g, b)
    lit = (mx + mn) / 2
    if mx == mn:
        hue, sat = 0.0, 0.0
    else:
        d = mx - mn
        sat = d / (1 - abs(2 * lit - 1)) if lit not in (0, 1) else 0.0
        if mx == r:
            hue = ((g - b) / d) % 6
        elif mx == g:
            hue = (b - r) / d + 2
        else:
            hue = (r - g) / d + 4
        hue *= 60
    if sat < 0.12:
        if lit < 0.08:
            return "black"
        if lit < 0.22:
            return "charcoal"
        if lit < 0.40:
            return "gray"
        if lit < 0.62:
            return "silver"
        if lit < 0.92:
            return "light-gray"
        return "white"
    if sat < 0.30:
        if lit >= 0.80:
            return "silver"
        if lit <= 0.20:
            return "charcoal"
        if hue < 50 and lit < 0.42:
            return "brown"
        if 25 <= hue < 85:
            return "taupe" if lit > 0.45 else "olive"
        if 85 <= hue < 165:
            return "sage"
        if 165 <= hue < 255:
            return "slate"
        if 255 <= hue < 330:
            return "mauve"
        return "taupe" if hue < 25 or hue >= 330 else "steel"
    if lit < 0.18:
        shade = "dark "
    elif lit > 0.78:
        shade = "light "
    else:
        shade = ""
    if hue < 12 or hue >= 348:
        tone = "peach" if lit > 0.70 else "red"
    elif hue < 32:
        tone = "orange"
    elif hue < 48:
        tone = "amber"
    elif hue < 72:
        tone = "yellow"
    elif hue < 150:
        tone = "green"
    elif hue < 175:
        tone = "teal"
    elif hue < 200:
        tone = "cyan"
    elif hue < 250:
        if lit < 0.32:
            tone = "navy"
        elif lit > 0.45 and hue < 225:
            tone = "sky"
        else:
            tone = "blue"
    elif hue < 275:
        tone = "indigo"
    elif hue < 310:
        tone = "purple"
    elif hue < 335:
        tone = "magenta"
    else:
        tone = "pink"
    return (shade + tone).strip()


def swatch(hexcol: str, label: str | None = None) -> Static:
    fg = "#000000" if luminance(hexcol) > 0.5 else "#ffffff"
    chip = Static(f"{label or color_name(hexcol)}  {hexcol}", markup=False, classes="swatch")
    chip.set_styles(f"background: {hexcol}; color: {fg};")
    return chip


def shell_data() -> dict:
    return read_json(SHELL_JSON)


def theme_dirs() -> list[dict]:
    result: list[dict] = []
    seen: set[str] = set()

    for base, user in ((CONFIG_DIR / "themes", True), (Path("/usr/share/omarchy/themes"), False)):
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if d.name.startswith(".") or not d.is_dir() or not (d / "colors.toml").is_file():
                continue
            name = d.name
            if name in seen:
                continue
            seen.add(name)
            result.append({"name": name, "dir": d, "user": user})
    return result


def theme_colors(tdir: Path) -> dict:
    path = tdir / "colors.toml"
    if not path.is_file():
        return {}
    try:
        with path.open("rb") as fh:
            return tomllib.load(fh)
    except Exception:
        return {}


def active_theme() -> str:
    out = sh(["omarchy", "theme", "current"])
    return out.splitlines()[0].strip() if out else ""


def theme_names_match(a: str, b: str) -> bool:
    return a.strip().lower().replace(" ", "-") == b.strip().lower()


