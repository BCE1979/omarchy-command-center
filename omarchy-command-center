    def compose(self) -> ComposeResult:
        with Horizontal(classes="pads"):
            with Vertical(id="themes-col-left", classes="col"):
                yield Label("Themes — Enter to apply", classes="section-title")
                yield OptionList(id="theme-list")
            with Vertical(id="themes-col-right", classes="col"):
                yield Label("Preview", classes="section-title")
                yield Static("", id="theme-name", classes="stat")
                yield Static("", id="theme-path", classes="hint")
                yield Vertical(id="theme-core", classes="swatch-box")
                yield Vertical(id="theme-palette", classes="swatch-box")
                yield Horizontal(
                    Button("Apply theme", id="theme-apply", variant="primary"),
                    Button("Refresh", id="theme-refresh"),
                    classes="buttons-row",
                )

    def on_mount(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#theme-refresh")
    def _refresh_clicked(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#theme-apply")
    def _apply_clicked(self) -> None:
        ol = self.query_one("#theme-list", OptionList)
        idx = ol.highlighted
        if idx is None or not self.themes:
            self.notify("Select a theme first", severity="warning")
            return
        name = self.themes[idx]["name"]
        self.notify(f"Applying theme {name}…", timeout=5)
        out, err, code = run(["omarchy", "theme", "set", name])
        if code == 0:
            self.notify(f"Theme applied: {name}")
            self.app._apply_theme_css()
        else:
            self.notify(f"Failed to apply theme: {err.strip() or out.strip()}", severity="error")
        self.refresh_view()

    @on(OptionList.OptionHighlighted, "#theme-list")
    def _highlighted(self, ev: OptionList.OptionHighlighted) -> None:
        self._preview(ev.option_index)

    def refresh_view(self) -> None:
        self.current = active_theme()
        self.themes = theme_dirs()
        ol = self.query_one("#theme-list", OptionList)
        ol.clear_options()
        opts = []
        active_idx = 0
        for i, t in enumerate(self.themes):
            marker = "● " if theme_names_match(self.current, t["name"]) else "○ "
            label = marker + t["name"]
            if not t["user"]:
                label += "  (built-in)"
            opts.append(Option(label, id=f"th-{slug(t['name'])}"))
            if theme_names_match(self.current, t["name"]):
                active_idx = i
        ol.add_options(opts)
        if self.themes:
            try:
                ol.highlighted = active_idx
            except Exception:
                pass
            self._preview(active_idx)

    def _preview(self, idx: int) -> None:
        if idx is None or not self.themes or not (0 <= idx < len(self.themes)):
            return
        t = self.themes[idx]
        name = t["name"]
        origin = "user" if t["user"] else "built-in"
        self.query_one("#theme-name", Static).update(f"[b {ACCENT}]{name}[/]  [i]{origin}[/]")
        self.query_one("#theme-path", Static).update(f"{t['dir']}")
        colors = theme_colors(t["dir"])
        core_keys = ("background", "foreground", "accent", "selection", "active_border_color")
        if not colors:
            self._fill_swatch_rows("#theme-core", [])
            self.query_one("#theme-core").mount(Static(f"[{STEEL}]no colors.toml palette[/]", classes="hint"))
            self._fill_swatch_rows("#theme-palette", [])
            return
        self._fill_swatch_rows(
            "#theme-core",
            self._pairs([(k, colors[k]) for k in core_keys if self._is_hex(colors.get(k))]),
            roles=True,
        )
        self._fill_swatch_rows("#theme-palette", self._ansi_rows(colors))

    @staticmethod
    def _is_hex(val: object) -> bool:
        return isinstance(val, str) and val.startswith("#") and len(val) >= 4

    @staticmethod
    def _pairs(items: list[tuple[str, str]]) -> list[list[tuple[str, str]]]:
        return [items[i : i + 2] for i in range(0, len(items), 2)]

    def _ansi_rows(self, colors: dict) -> list[list[tuple[str, str]]]:
        rows: list[list[tuple[str, str]]] = []
        for base in ("red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown"):
            row: list[tuple[str, str]] = []
            if self._is_hex(colors.get(base)):
                row.append((base, colors[base]))
            bright = f"bright_{base}"
            if self._is_hex(colors.get(bright)):
                row.append((bright, colors[bright]))
            if row:
                rows.append(row)
        return rows

    def _fill_swatch_rows(self, widget_id: str, rows: list[list[tuple[str, str]]], *, roles: bool = False) -> None:
        box = self.query_one(widget_id)
        box.remove_children()
        for row in rows:
            chips = [swatch(val, name if roles else None) for name, val in row]
            if chips:
                box.mount(Horizontal(*chips, classes="swatch-row"))


class BarView(VerticalScroll):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.sections = {"left": [], "center": [], "right": []}
        self.position = "top"
        self.transparent = False
        self.anchor = ""
        self.lock = 0
        self.ssaver = 0

    def compose(self) -> ComposeResult:
        with Horizontal(classes="pads"):
            for sec in ("left", "center", "right"):
                yield Vertical(
                    Label(sec.upper() + " SECTION", classes="section-title"),
                    OptionList(id=f"bar-{sec}"),
                    classes="col",
                )
        yield Horizontal(
            Button("▲ Up", id="btn-up"),
            Button("▼ Down", id="btn-down"),
            Button("◀ To prev", id="btn-prev"),
            Button("▶ To next", id="btn-next"),
            Button("Remove", id="btn-remove"),
            Button("Add custom", id="btn-add"),
            classes="buttons-row",
        )
        yield Horizontal(
            Input(id="bar-add-input", placeholder="widget id e.g. omarchy.spacer"),
            classes="pads",
        )
        for label, control in (
            ("Position", Select(
                [(l, v) for v, l in (("top", "Top"), ("bottom", "Bottom"), ("left", "Left"), ("right", "Right"))],
                id="bar-pos",
            )),
            ("Transparent", Switch(id="bar-trans")),
            ("Clock anchor", Input(id="bar-anchor", placeholder="e.g. omarchy.clock")),
            ("Lock idle (s)", Input(id="bar-lock")),
            ("Screensaver (s)", Input(id="bar-ssaver")),
        ):
            with Horizontal(classes="settings-row"):
                yield Label(label, classes="kind-label")
                yield control
        yield Horizontal(
            Button("Save & apply", id="btn-save", variant="primary"),
            Button("Reset from disk", id="btn-reset"),
            classes="buttons-row",
        )

    def on_mount(self) -> None:
        self.load()

    @on(Button.Pressed, "#btn-reset")
    def _reset(self) -> None:
        self.load()
        self.notify("Bar config reloaded from disk")

    @on(Button.Pressed, "#btn-up")
    def _up(self) -> None:
        self._move_selected(-1)

    @on(Button.Pressed, "#btn-down")
    def _down(self) -> None:
        self._move_selected(1)

    @on(Button.Pressed, "#btn-prev")
    def _to_prev(self) -> None:
        self._hop(-1)

    @on(Button.Pressed, "#btn-next")
    def _to_next(self) -> None:
        self._hop(1)

    @on(Button.Pressed, "#btn-remove")
    def _remove(self) -> None:
        sec = self._cur_section()
        ol = self.query_one(f"#bar-{sec}", OptionList)
        hl = ol.highlighted
        if hl is None or not (0 <= hl < len(self.sections[sec])):
            return
        removed = self.sections[sec].pop(hl)
        self._rerender(hl, sec)
        self.notify(f"Removed {removed.get('id', removed) if isinstance(removed, dict) else removed}")

    @on(Button.Pressed, "#btn-add")
    def _add_custom(self) -> None:
        inp = self.query_one("#bar-add-input", Input)
        wid = inp.value.strip()
        if not wid:
            self.notify("Enter a widget id first", severity="warning")
            return
        sec = self._cur_section()
        self.sections[sec].append({"id": wid})
        inp.value = ""
        self._rerender(len(self.sections[sec]) - 1, sec)
        self.notify(f"Added {wid} to {sec}")

    @on(Button.Pressed, "#btn-save")
    def _save(self) -> None:
        self._read_settings_inputs()
        data = shell_data()
        bar = data.setdefault("bar", {})
        layout = {}
        for k, widgets in self.sections.items():
            items = []
            for w in widgets:
                if isinstance(w, dict):
                    item = dict(w)
                    if "id" not in item:
                        item["id"] = str(w)
                    items.append(item)
                else:
                    items.append({"id": str(w)})
            layout[k] = items
        bar["layout"] = layout
        bar["position"] = self.position
        bar["transparent"] = self.transparent
        bar["centerAnchor"] = self.anchor
        data.setdefault("idle", {})
        data["idle"]["lock"] = int(self.lock or 0)
        data["idle"]["screensaver"] = int(self.ssaver or 0)
        write_json(SHELL_JSON, data, backup=True)
        errors = []
        for cmd in (
            ["omarchy", "bar", "position", self.position],
            ["omarchy", "bar", "transparent", "true" if self.transparent else "false"],
        ):
            out, err, code = run(cmd)
            if code != 0:
                errors.append((err or out).strip() or " ".join(cmd))
        if errors:
            self.notify(errors[0], severity="error")
            return
        self.notify("Bar config saved and applied")

    def load(self) -> None:
        data = shell_data()
        bar = data.get("bar") or {}
        layout = bar.get("layout") or {}
        for sec in self.sections:
            entries = layout.get(sec) or []
            self.sections[sec] = [
                dict(w) if isinstance(w, dict) else {"id": str(w)} for w in entries
            ]
        self.position = bar.get("position", "top")
        self.transparent = bool(bar.get("transparent", False))
        self.anchor = bar.get("centerAnchor", "")
        idle = data.get("idle") or {}
        self.lock = idle.get("lock") or 0
        self.ssaver = idle.get("screensaver") or 0
        self._sync_settings_inputs()
        self._rerender(0)

    def _sync_settings_inputs(self) -> None:
        try:
            self.query_one("#bar-pos", Select).value = self.position
        except Exception:
            pass
        self.query_one("#bar-trans", Switch).value = self.transparent
        self.query_one("#bar-anchor", Input).value = self.anchor
        self.query_one("#bar-lock", Input).value = str(self.lock)
        self.query_one("#bar-ssaver", Input).value = str(self.ssaver)

    def _read_settings_inputs(self) -> None:
        try:
            self.position = str(self.query_one("#bar-pos", Select).value)
        except Exception:
            pass
        self.transparent = bool(self.query_one("#bar-trans", Switch).value)
        self.anchor = self.query_one("#bar-anchor", Input).value.strip()
        try:
            self.lock = int(self.query_one("#bar-lock", Input).value.strip() or 0)
        except ValueError:
            self.lock = 0
        try:
            self.ssaver = int(self.query_one("#bar-ssaver", Input).value.strip() or 0)
        except ValueError:
            self.ssaver = 0

    def _cur_section(self) -> str:
        focused = self.app.focused
        if focused is not None:
            fid = getattr(focused, "id", None)
            if fid in (f"bar-{s}" for s in self.sections):
                return fid.removeprefix("bar-")
        return "center"

    def _move_selected(self, delta: int) -> None:
        sec = self._cur_section()
        ol = self.query_one(f"#bar-{sec}", OptionList)
        hl = ol.highlighted
        if hl is None or not (0 <= hl < len(self.sections[sec])):
            return
        j = hl + delta
        if not (0 <= j < len(self.sections[sec])):
            return
        lst = self.sections[sec]
        lst[hl], lst[j] = lst[j], lst[hl]
        self._rerender(j, sec)

    def _hop(self, step: int) -> None:
        order = ["left", "center", "right"]
        sec = self._cur_section()
        ol = self.query_one(f"#bar-{sec}", OptionList)
        hl = ol.highlighted
        if hl is None or not (0 <= hl < len(self.sections[sec])):
            return
        item = self.sections[sec].pop(hl)
        j_sec = (order.index(sec) + step) % 3
        self.sections[order[j_sec]].append(item)
        self._rerender(len(self.sections[order[j_sec]]) - 1, order[j_sec])

    def _rerender(self, keep: Optional[int] = None, section: Optional[str] = None) -> None:
        for sec in ("left", "center", "right"):
            ol = self.query_one(f"#bar-{sec}", OptionList)
            hl = ol.highlighted
            ol.clear_options()
            ol.add_options(
                [
                    Option(
                        str(w.get("id", w) if isinstance(w, dict) else w),
                        id=f"{sec}-{i}",
                    )
                    for i, w in enumerate(self.sections[sec])
                ]
            )
            if section == sec and keep is not None and 0 <= keep < ol.option_count:
                try:
                    ol.highlighted = keep
                except Exception:
                    pass
            elif hl is not None and ol.option_count > 0:
                try:
                    ol.highlighted = min(hl, ol.option_count - 1)
                except Exception:
                    pass
        if section is None and keep is not None:
            for sec in ("left", "center", "right"):
                ol = self.query_one(f"#bar-{sec}", OptionList)
                if ol.option_count > 0:
                    try:
                        ol.highlighted = keep if 0 <= keep < ol.option_count else 0
                    except Exception:
                        pass
                    break


