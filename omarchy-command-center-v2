def get_wallpaper_dir() -> Path:
    theme_name = active_theme()
    if not theme_name:
        return Path("~/.config/omarchy/themes").expanduser()
    slug = theme_name.lower().replace(" ", "-")
    user_bg = USER_BG_DIR / slug
    if user_bg.is_dir():
        return user_bg
    theme_dir = Path("~/.config/omarchy/themes").expanduser() / slug
    if theme_dir.is_dir() and (theme_dir / "backgrounds").is_dir():
        return theme_dir / "backgrounds"
    for base in [Path("/usr/share/omarchy/themes"), Path("~/.config/omarchy/themes").expanduser()]:
        for d in base.iterdir():
            if d.is_dir() and theme_names_match(d.name, theme_name):
                if (d / "backgrounds").is_dir():
                    return d / "backgrounds"
    return Path("~/.config/omarchy/themes").expanduser()

