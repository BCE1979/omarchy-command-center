        self.mode = mode
        self.key = key
        self.command = command
        self.description = description
        self.editing = editing

    def compose(self) -> ComposeResult:
        with Vertical(id="rebind-dialog"):
            yield Label(f"Neovim keymap {'edit' if self.editing else 'add'}", classes="section-title")
            yield Label("Mode", classes="kind-label")
            yield Select([(m, m) for m in NVIM_MODES], id="rb-mode", value=self.mode)
            yield Label("Key", classes="kind-label")
            yield Input(id="rb-key", value=self.key, placeholder="e.g. <leader>f, <C-p>, j")
            yield Label("Command", classes="kind-label")
            yield Input(id="rb-cmd", value=self.command, placeholder="e.g. :Telescope find_files<CR>, <cmd>w<CR>")
            yield Label("Description", classes="kind-label")
            yield Input(id="rb-desc", value=self.description, placeholder="Optional description")
            yield Horizontal(
                Button("Save", id="rb-save", variant="primary"),
                Button("Unbind" if self.editing else "Cancel", id="rb-unbind" if self.editing else "rb-cancel"),
                classes="buttons-row",
            )

    def on_mount(self) -> None:
        self.query_one("#rb-key", Input).focus()

    @on(Button.Pressed)
    def _button(self, ev: Button.Pressed) -> None:
        if ev.button.id == "rb-save":
            mode = str(self.query_one("#rb-mode", Select).value)
            key = self.query_one("#rb-key", Input).value.strip()
            cmd = self.query_one("#rb-cmd", Input).value.strip()
            desc = self.query_one("#rb-desc", Input).value.strip()
            if not mode:
                self.notify("Mode is required", severity="warning")
                return
            if not key:
                self.notify("Key is required", severity="warning")
                return
            if not cmd:
                self.notify("Command is required", severity="warning")
                return
            if not validate_nvim_mode(mode):
                self.notify(f"Invalid mode: {mode}", severity="warning")
                return
            action = "save" if self.editing else "add"
            self.dismiss({"action": action, "mode": mode, "key": key, "command": cmd, "description": desc, "old_key": self.key})
        elif ev.button.id in ("rb-unbind", "rb-cancel"):
            if ev.button.id == "rb-unbind" and self.editing:
                self.dismiss({"action": "unbind", "mode": self.mode, "key": self.key})
            else:
                self.dismiss({"action": "cancel"})


