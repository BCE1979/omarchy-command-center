    def _toggle(self) -> None:
        ol = self.query_one("#hook-list", OptionList)
        idx = ol.highlighted
        if idx is None or not (0 <= idx < len(self.hooks)):
            self.notify("Select a hook first", severity="warning")
            return
        h = self.hooks[idx]
        path = h["path"]
        if h["active"]:
