            classes="buttons-row",
        )
        yield Static("", id="in-status", classes="hint")

    def on_mount(self) -> None:
        self.refresh_view()

    def refresh_view(self) -> None:
        s = read_input_settings()
        self.query_one("#in-sens", Input).value = str(s["sensitivity"])
        try:
            self.query_one("#in-accel", Select).value = s["accel_profile"] if s["accel_profile"] in ("adaptive", "flat") else "adaptive"
        except Exception:
            pass
        try:
            self.query_one("#in-follow", Select).value = str(int(s["follow_mouse"]))
        except Exception:
            pass
        self.query_one("#in-layout", Input).value = str(s["kb_layout"])
        self.query_one("#in-variant", Input).value = str(s["kb_variant"])
        self.query_one("#in-options", Input).value = str(s["kb_options"])
        self.query_one("#in-rate", Input).value = str(s["repeat_rate"])
        self.query_one("#in-delay", Input).value = str(s["repeat_delay"])
        self.query_one("#in-numlock", Switch).value = bool(s["numlock_by_default"])
        self.query_one("#in-natural", Switch).value = bool(s["natural_scroll"])
        self.query_one("#in-clickfinger", Switch).value = bool(s["clickfinger_behavior"])
        self.query_one("#in-dwt", Switch).value = bool(s["disable_while_typing"])
        self.query_one("#in-scroll", Input).value = str(s["scroll_factor"])
        self.query_one("#in-status", Static).update("Live Hyprland values. Save writes input.lua.")

    def _collect(self) -> dict | None:
        def num(widget_id: str, kind):
            raw = self.query_one(widget_id, Input).value.strip()
            return kind(raw)

        try:
            sensitivity = num("#in-sens", float)
            repeat_rate = num("#in-rate", int)
            repeat_delay = num("#in-delay", int)
            scroll_factor = num("#in-scroll", float)
        except ValueError:
            self.notify("Sensitivity, rates, and scroll factor must be numbers", severity="warning")
            return None
        if not -1 <= sensitivity <= 1:
            self.notify("Sensitivity must be between -1 and 1", severity="warning")
            return None
        layout = self.query_one("#in-layout", Input).value.strip() or "us"
        accel = str(self.query_one("#in-accel", Select).value or "adaptive")
        follow = str(self.query_one("#in-follow", Select).value or "1")
        return {
            "sensitivity": sensitivity,
            "accel_profile": accel if accel in ("adaptive", "flat") else "adaptive",
            "follow_mouse": int(follow),
            "kb_layout": layout,
            "kb_variant": self.query_one("#in-variant", Input).value.strip(),
            "kb_options": self.query_one("#in-options", Input).value.strip(),
            "repeat_rate": repeat_rate,
            "repeat_delay": repeat_delay,
            "numlock_by_default": self.query_one("#in-numlock", Switch).value,
            "natural_scroll": self.query_one("#in-natural", Switch).value,
            "clickfinger_behavior": self.query_one("#in-clickfinger", Switch).value,
            "disable_while_typing": self.query_one("#in-dwt", Switch).value,
            "scroll_factor": scroll_factor,
        }

    @on(Button.Pressed, "#in-reload")
    def _reload(self) -> None:
        self.refresh_view()
        self.notify("Reloaded live input values")

    @on(Button.Pressed, "#in-save")
    def _save(self) -> None:
        settings = self._collect()
        if not settings:
            return
        ok, msg = write_input_settings(settings)
        if ok:
            self.notify("Input settings applied")
            self.query_one("#in-status", Static).update("Saved ~/.config/hypr/input.lua and reloaded Hyprland.")
        else:
            self.notify(msg, severity="error")
            self.query_one("#in-status", Static).update(msg)


class WorkspacesView(VerticalScroll):

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.workspaces: list[dict] = []
        self.saved_names: dict[int, str] = {}

    def compose(self) -> ComposeResult:
        yield Label("Workspaces 1–10 — Enter to rename. Empty slots stay listed.", classes="section-title")
        yield OptionList(id="workspace-list")
        yield Horizontal(
            Button("Rename", id="ws-rename", variant="primary"),
            Button("Save names", id="ws-save"),
            Button("Clone plugin", id="ws-clone-plugin"),
            Button("Refresh", id="ws-refresh"),
            classes="buttons-row",
        )
        yield Static("", id="ws-info", classes="hint")
        yield Static("", id="ws-persist-status", classes="hint")

    def on_mount(self) -> None:
        self.refresh_view()

    @on(OptionList.OptionSelected, "#workspace-list")
    def _list_selected(self) -> None:
        self.action_rename()

    def action_rename(self) -> None:
        ol = self.query_one("#workspace-list", OptionList)
        idx = ol.highlighted
        if idx is None or not (0 <= idx < len(self.workspaces)):
            self.notify("Select a workspace first", severity="warning")
            return
        ws = self.workspaces[idx]
        ws_id = ws["id"]
        self._rename_ws_id = ws_id
        current_name = self.saved_names.get(ws_id, ws.get("name", str(ws_id)))
        self.app.push_screen(WorkspaceRenameScreen(ws_id, current_name), self._on_rename_result)

    def _on_rename_result(self, result: dict | None) -> None:
        if not result or result.get("action") != "save":
            return
        ws_id = getattr(self, "_rename_ws_id", None)
        if ws_id is None:
            return
        new_name = result["name"].strip()
        if not new_name:
            self.notify("Name is required", severity="warning")
            return
        self.saved_names[ws_id] = new_name
        if save_workspace_labels_to_plugin(self.saved_names):
            self.notify(f"Workspace {ws_id} is now {new_name}")
            self.refresh_view()
        else:
            self.notify("Could not write workspace names", severity="error")

    @on(Button.Pressed, "#ws-refresh")
    def _refresh(self) -> None:
        self.refresh_view()

    @on(Button.Pressed, "#ws-rename")
    def _rename(self) -> None:
        self.action_rename()

    @on(Button.Pressed, "#ws-save")
    def _save(self) -> None:
        if not self.saved_names:
            self.notify("No names to save", severity="warning")
            return
        ok, msg = ensure_named_workspaces_on_bar()
        if not ok:
            self.notify(msg, severity="error")
            return
        if save_workspace_labels_to_plugin(self.saved_names):
            self.notify(f"Workspace names saved on {msg}")
            self.refresh_view()
        else:
            self.notify("Could not write names into the workspaces plugin", severity="error")

    @on(Button.Pressed, "#ws-clone-plugin")
    def _clone_plugin(self) -> None:
        ok, msg = ensure_named_workspaces_on_bar()
        if ok:
            self.notify(f"Bar is using {msg} for workspace names")
            self.refresh_view()
        else:
            self.notify(msg, severity="error")

    @on(OptionList.OptionHighlighted, "#workspace-list")
    def _highlight(self, ev: OptionList.OptionHighlighted) -> None:
        if 0 <= ev.option_index < len(self.workspaces):
            ws = self.workspaces[ev.option_index]
            ws_id = ws["id"]
            current_name = self.saved_names.get(ws_id, ws.get("name", str(ws_id)))
            monitor = ws.get("monitor") or "inactive"
            windows = ws.get("windows", 0)
            self.query_one("#ws-info", Static).update(
                f"Workspace {ws_id} on {monitor} — {windows} windows"
            )

    def refresh_view(self) -> None:
        live = {int(ws["id"]): ws for ws in get_hypr_workspaces() if ws.get("id")}
        self.saved_names = load_workspace_labels_from_plugin()
        self.workspaces = []
        ol = self.query_one("#workspace-list", OptionList)
        ol.clear_options()
        for ws_id in range(1, WORKSPACE_SLOT_COUNT + 1):
            ws = live.get(ws_id, {"id": ws_id, "name": str(ws_id), "monitor": "", "windows": 0})
            self.workspaces.append(ws)
            name = self.saved_names.get(ws_id, str(ws_id))
            marker = "" if ws_id in live else "  (inactive)"
            ol.add_options([Option(f"{ws_id}: {name}{marker}", id=f"ws-{ws_id}")])
        if self.workspaces:
            self._highlight(type("Ev", (), {"option_index": 0})())
        plugin_dir = get_cloned_workspaces_plugin_dir()
        if plugin_dir:
            status = f"Names are {WORKSPACE_NAMES_JSON} (watched by {plugin_dir.name}). All 10 slots are editable."
        else:
            status = "Clone omarchy.workspaces first — stock bar chips are numbers, not names."
        self.query_one("#ws-persist-status", Static).update(f"[b {ACCENT}]{status}[/]")


