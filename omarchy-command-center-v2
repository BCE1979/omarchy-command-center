def build_hypr_rows() -> tuple[tuple[str, str], list, set, bool]:
    out = sh(["omarchy", "menu", "keybindings", "--print"])
    rows = []
    for line in out.splitlines():
        if "\u2192" not in line:
            continue
        key, desc = (p.strip() for p in line.split("\u2192", 1))
        rows.append([key, desc])
    overrides = set()
    defaults_off = False
    if HYPR_BINDINGS.exists():
        for line in HYPR_BINDINGS.read_text().splitlines():
            s = line.strip()
            if not s or s.startswith("--"):
                continue
            if "omarchy_default_bindings = false" in s:
                defaults_off = True
            m = re_search(r'o\.bind\(\s*"([^"]+)"', s) or re_search(r'hl\.unbind\(\s*"([^"]+)"', s)
            if m:
                overrides.add(m)
    marked = []
    for row in rows:
        if row[0] in overrides:
            marked.append([row[0], row[1] + "   [user override]"])
        else:
            marked.append(row)
    return ("Key Binding", "Description"), marked, overrides, defaults_off


def _hbind_key(line: str) -> Optional[str]:
    s = line.strip()
    if not s or s.startswith("--"):
        return None
    m = re.search(r"\b(?:o\.bind|hl\.unbind)\(\s*\"([^\"]+)\"", s)
    return m.group(1) if m else None


def hypr_overrides_map() -> dict[str, tuple[str, str]]:
    overrides = {}
    if not HYPR_BINDINGS.is_file():
        return overrides
    for line in HYPR_BINDINGS.read_text().splitlines():
        m = re.search(
            r'o\.bind\(\s*"([^"]+)"\s*,\s*(?:nil|"((?:[^"\\]|\\.)*)")\s*,\s*"((?:[^"\\]|\\.)*)"',
            line,
        )
        if m:
            overrides[m.group(1)] = (_unlua_str(m.group(2) or ""), _unlua_str(m.group(3)))
    return overrides


def _unlua_str(s: str) -> str:
    return s.replace('\\"', '"').replace("\\\\", "\\")


def _lua_str(s: str) -> str:
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _write_hypr_bindings(body: str) -> None:
    backup(HYPR_BINDINGS)
    HYPR_BINDINGS.write_text(body.rstrip() + "\n")


def hypr_write_change(old_key: str, new_key: str, description: str, command: str, default_keys: set) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        key = _hbind_key(ln)
        if key is not None and key in (old_key, new_key):
            continue
        lines.append(ln)
    kept = "\n".join(lines).rstrip()
    additions = []
    if new_key in default_keys:
        additions.append(f'hl.unbind("{new_key}")')
    desc = f'"{_lua_str(description)}"' if description else "nil"
    additions.append(f'o.bind("{new_key}", {desc}, "{_lua_str(command)}")')
    body = kept + "\n" + "\n".join(additions) if kept else "\n".join(additions)
    _write_hypr_bindings(body)


def hypr_write_unbind(key: str) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        matched = _hbind_key(ln)
        if matched is not None and matched == key:
            continue
        lines.append(ln)
    kept = "\n".join(lines).rstrip()
    body = kept + "\n" + f'hl.unbind("{key}")' if kept else f'hl.unbind("{key}")'
    _write_hypr_bindings(body)


def hypr_write_revert(key: str) -> None:
    text = HYPR_BINDINGS.read_text() if HYPR_BINDINGS.is_file() else ""
    lines = []
    for ln in text.splitlines():
        matched = _hbind_key(ln)
        if matched is not None and matched == key:
            continue
        lines.append(ln)
    _write_hypr_bindings("\n".join(lines).rstrip())


TMUX_KEY_RE = re.compile(
    r"^(?:[CMS]-)*(?:F1[0-2]|F[1-9]|Space|Enter|Escape|Up|Down|Left|Right|[!-~])$"
)
TMUX_TABLES = ("prefix", "root", "copy-mode-vi")


def validate_tmux_key(key: str) -> bool:
    return bool(key) and bool(TMUX_KEY_RE.fullmatch(key))


def _tmux_table(flags: list[str]) -> str:
    if "-T" in flags:
        i = flags.index("-T")
        if i + 1 < len(flags):
            return flags[i + 1]
    if "-n" in flags:
        return "root"
    return "prefix"


def _tmux_flags_for_table(table: str) -> list[str]:
    if table == "root":
        return ["-n"]
    if table and table != "prefix":
        return ["-T", table]
    return []


def parse_tmux_bind(line: str) -> Optional[dict]:
    s = line.strip()
    if not s.startswith("bind "):
        return None
    m = re.match(r'bind\s+(?:-N\s+"(?P<desc>[^"]*)"\s+)?(?P<rest>.+)$', s)
    if not m:
        return None
    toks = m.group("rest").split()
    flags: list[str] = []
    i = 0
    while i < len(toks) and toks[i].startswith("-"):
        if toks[i] in ("-T", "-t", "-b", "-g") and i + 1 < len(toks):
            flags.extend([toks[i], toks[i + 1]])
            i += 2
        else:
            flags.append(toks[i])
            i += 1
    if i >= len(toks):
        return None
    desc = (m.group("desc") or "").strip()
    key = toks[i]
    cmd = " ".join(toks[i + 1 :])
    return {
        "key": key,
        "desc": desc,
        "cmd": cmd,
        "flags": flags,
        "table": _tmux_table(flags),
    }


def _tmux_bind_line(desc: str, flags: list[str], key: str, cmd: str) -> str:
    flag_s = (" " + " ".join(flags)) if flags else ""
    if desc:
        return f'bind -N "{_lua_str(desc)}"{flag_s} {key} {cmd}'
    return f"bind{flag_s} {key} {cmd}"


def _tmux_drop_keys() -> tuple[bool, list[str]]:
    if not TMUX_CONF.exists():
        return False, []
    return True, TMUX_CONF.read_text().splitlines()


def tmux_write_change(old_table: str, old_key: str, new_key: str, desc: str, cmd: str, flags: list[str]) -> bool:
    ok, lines = _tmux_drop_keys()
    if not ok:
        return False
    backup(TMUX_CONF)
    table = _tmux_table(flags)
    new_lines = []
    for line in lines:
        parsed = parse_tmux_bind(line)
        if parsed and (
            (parsed["table"] == old_table and parsed["key"] == old_key)
            or (parsed["table"] == table and parsed["key"] == new_key)
        ):
            continue
        new_lines.append(line)
    new_lines.append(_tmux_bind_line(desc, flags, new_key, cmd))
    TMUX_CONF.write_text("\n".join(new_lines).rstrip() + "\n")
    return True


def tmux_write_unbind(table: str, key: str) -> bool:
    ok, lines = _tmux_drop_keys()
    if not ok:
        return False
    backup(TMUX_CONF)
    new_lines = []
    for line in lines:
        parsed = parse_tmux_bind(line)
        if parsed and parsed["table"] == table and parsed["key"] == key:
            continue
        new_lines.append(line)
    TMUX_CONF.write_text("\n".join(new_lines).rstrip() + "\n")
