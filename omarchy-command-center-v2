            classes="buttons-row",
        )

    def on_mount(self) -> None:
        self.advanced_mode = advanced_mode_pref()
        try:
            self.query_one("#kb-advanced", Switch).value = self.advanced_mode
        except Exception:
            pass
        self.refresh_view()
        self._update_edit_buttons()

    def _hypr_active(self) -> bool:
        try:
            return str(self.query_one(TabbedContent).active) in ("pane-hypr", "hypr")
        except Exception:
            return True

    def _active_tab(self) -> str:
        try:
            return str(self.query_one(TabbedContent).active).removeprefix("pane-")
        except Exception:
            return "hypr"

    def _update_edit_buttons(self) -> None:
        hypr = self._hypr_active()
        adv = self.advanced_mode
        tab = self._active_tab()
        editable = hypr or (adv and tab in ("tmux", "herdr", "nvim"))
        try:
            self.query_one("#kb-edit", Button).disabled = not editable
            self.query_one("#kb-unbind", Button).disabled = not editable
            self.query_one("#kb-add", Button).disabled = not adv
            self.query_one("#kb-add", Button).display = adv
        except Exception:
            pass

    @on(TabbedContent.TabActivated)
    def _tab_activated(self, ev: TabbedContent.TabActivated) -> None:
        self._update_edit_buttons()

    @on(Switch.Changed, "#kb-advanced")
    def _toggle_advanced(self, ev: Switch.Changed) -> None:
        self.advanced_mode = ev.value
        set_advanced_mode_pref(self.advanced_mode)
        self._update_edit_buttons()
        self.notify(f"Advanced editing {'enabled' if self.advanced_mode else 'disabled'}")

    def refresh_view(self) -> None:
        cols, rows, overrides, defaults_off = build_hypr_rows()
        self.rows["hypr"] = rows
        self.rows["tmux"] = build_tmux_rows()
        self.rows["herdr"] = build_herdr_rows()
        self.rows["nvim"] = build_nvim_rows()
        self.hypr_overrides = overrides
        self.hypr_defaults_off = defaults_off
        self.hypr_default_keys = {r[0] for r in rows}
        self.hypr_override_map = hypr_overrides_map()
        for tab, _label, cols_def in self.TABS:
            self.render_table(tab, cols_def)
        if defaults_off:
            self.notify("Hyprland default bindings are all disabled (bindings.lua flag)", timeout=3)

    @on(Button.Pressed, "#kb-edit")
    def _edit(self) -> None:
        self.edit_selected()

    @on(Button.Pressed, "#kb-unbind")
    async def _unbind(self) -> None:
        tab = self._active_tab()
        if tab == "hypr":
            await self._unbind_hypr()
        elif tab == "tmux":
            await self._unbind_tmux()
        elif tab == "herdr":
            await self._unbind_herdr()
        elif tab == "nvim":
            await self._unbind_nvim()

    @on(Button.Pressed, "#kb-add")
    async def _add(self) -> None:
        tab = self._active_tab()
        if tab == "tmux":
            await self._add_tmux()
        elif tab == "herdr":
            await self._add_herdr()
        elif tab == "nvim":
            await self._add_nvim()

    @on(Button.Pressed, "#kb-refresh")
    def _refresh(self) -> None:
        self.refresh_view()

    @work
    async def edit_selected(self) -> None:
        tab = self._active_tab()
        if tab == "hypr":
            await self._edit_hypr()
        elif tab == "tmux":
            await self._edit_tmux()
        elif tab == "herdr":
            await self._edit_herdr()
        elif tab == "nvim":
            await self._edit_nvim()

    async def _edit_hypr(self) -> None:
        key = self._selected_key()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        desc, cmd = self.hypr_override_map.get(key, ("", ""))
        if not desc and self._hypr_display:
            table = self.query_one("#kb-table-hypr", DataTable)
            if 0 <= table.cursor_row < len(self._hypr_display):
                desc = self._hypr_display[table.cursor_row][1].split("  [user override]")[0]
        result = await self.app.push_screen_wait(RebindScreen(key, desc, cmd))
        if not result or result["action"] == "cancel":
            return
        if result["action"] == "unbind":
            hypr_write_unbind(key)
            self.notify(f"Unbound {key}")
        elif result["action"] == "revert":
            hypr_write_revert(key)
            self.notify(f"Restored default for {key}")
        else:
            hypr_write_change(key, result["key"], result["description"], result["command"], self.hypr_default_keys)
            verb = "Changed" if result["key"] == key else "Rebound"
            self.notify(f"{verb} {result['key']} → {result['command']}")
        self.refresh_view()

    async def _edit_tmux(self) -> None:
        table, key, desc, cmd, flags = self._selected_tmux()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        result = await self.app.push_screen_wait(
            TmuxRebindScreen(key, desc, cmd, table=table or "prefix", editing=True)
        )
        if not result or result["action"] == "cancel":
            return
        if result["action"] == "unbind":
            tmux_write_unbind(table, key)
            self.notify(f"Unbound {table}:{key}")
        else:
            new_table = result.get("table") or table
            new_flags = flags if new_table == table else _tmux_flags_for_table(new_table)
            tmux_write_change(table, key, result["key"], result["description"], result["command"], new_flags)
            self.notify(f"Updated {new_table}:{result['key']} → {result['command']}")
        self.refresh_view()

    async def _edit_herdr(self) -> None:
        name = self._selected_herdr()
        if not name:
            self.notify("Select a binding first", severity="warning")
            return
        row = next((r for r in self.rows["herdr"] if r[0] == name), None)
        combo = row[1] if row else ""
        result = await self.app.push_screen_wait(HerdrRebindScreen(name, combo, editing=True))
        if not result or result["action"] == "cancel":
            return
        if result["action"] == "unbind":
            herdr_write_unbind(name)
            self.notify(f"Unbound {name}")
        else:
            herdr_write_change(name, result["name"], result["combo"])
            shown = ", ".join(result["combo"]) if isinstance(result["combo"], list) else result["combo"]
            self.notify(f"Updated {result['name']} → {shown}")
        self.refresh_view()

    async def _edit_nvim(self) -> None:
        mode, key, cmd, desc = self._selected_nvim()
        if not mode or not key:
            self.notify("Select a binding first", severity="warning")
            return
        result = await self.app.push_screen_wait(NvimRebindScreen(mode, key, cmd, desc, editing=True))
        if not result or result["action"] == "cancel":
            return
        if result["action"] == "unbind":
            nvim_write_unbind(mode, key)
            self.notify(f"Unbound {mode}:{key}")
        else:
            nvim_write_change(mode, key, result["mode"], result["key"], result["command"], result["description"])
            self.notify(f"Updated {result['mode']}:{result['key']} → {result['command']}")
        self.refresh_view()

    async def _unbind_hypr(self) -> None:
        key = self._selected_key()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        hypr_write_unbind(key)
        self.notify(f"Unbound {key}")
        self.refresh_view()

    async def _unbind_tmux(self) -> None:
        table, key, _, _, _ = self._selected_tmux()
        if not key:
            self.notify("Select a binding first", severity="warning")
            return
        tmux_write_unbind(table, key)
        self.notify(f"Unbound {table}:{key}")
        self.refresh_view()

    async def _unbind_herdr(self) -> None:
        name = self._selected_herdr()
        if not name:
            self.notify("Select a binding first", severity="warning")
            return
        herdr_write_unbind(name)
        self.notify(f"Unbound {name}")
        self.refresh_view()

    async def _unbind_nvim(self) -> None:
        mode, key, _, _ = self._selected_nvim()
        if not mode or not key:
            self.notify("Select a binding first", severity="warning")
            return
        nvim_write_unbind(mode, key)
        self.notify(f"Unbound {mode}:{key}")
        self.refresh_view()

    async def _add_tmux(self) -> None:
        result = await self.app.push_screen_wait(TmuxRebindScreen())
        if not result or result["action"] == "cancel":
            return
        tmux_write_add(result["key"], result["description"], result["command"], result.get("table") or "prefix")
        self.notify(f"Added {result.get('table', 'prefix')}:{result['key']} → {result['command']}")
        self.refresh_view()

    async def _add_herdr(self) -> None:
        result = await self.app.push_screen_wait(HerdrRebindScreen())
        if not result or result["action"] == "cancel":
            return
        herdr_write_add(result["name"], result["combo"])
        self.notify(f"Added {result['name']} → {result['combo']}")
        self.refresh_view()

    async def _add_nvim(self) -> None:
        result = await self.app.push_screen_wait(NvimRebindScreen())
        if not result or result["action"] == "cancel":
            return
        nvim_write_add(result["mode"], result["key"], result["command"], result["description"])
        self.notify(f"Added {result['mode']}:{result['key']} → {result['command']}")
        self.refresh_view()

    def _cursor_row(self, tab: str) -> Optional[list]:
        table = self.query_one(f"#kb-table-{tab}", DataTable)
        rows = self._display.get(tab) or []
        if table.cursor_row is None or not (0 <= table.cursor_row < len(rows)):
            return None
        return rows[table.cursor_row]

    def _selected_key(self) -> Optional[str]:
        row = self._cursor_row("hypr")
        return None if not row else str(row[0])

    def _selected_tmux(self) -> tuple:
        row = self._cursor_row("tmux")
        if not row:
            return (None, None, None, None, None)
        table, key, desc, cmd = row[0], row[1], row[2], row[3]
        flags = row[4] if len(row) > 4 else _tmux_flags_for_table(table)
        return (table, key, desc, cmd, flags)

    def _selected_herdr(self) -> Optional[str]:
        row = self._cursor_row("herdr")
        return None if not row else row[0]

    def _selected_nvim(self) -> tuple:
        row = self._cursor_row("nvim")
        if not row:
            return (None, None, None, None)
        return (row[0], row[1], row[2], row[3])

    @on(Input.Changed)
    def _search(self, ev: Input.Changed) -> None:
        if not ev.input.id or not ev.input.id.startswith("kb-search-"):
            return
        tab = ev.input.id.removeprefix("kb-search-")
        cols = next(c for t, _l, c in self.TABS if t == tab)
        self.render_table(tab, cols)

    def render_table(self, tab: str, columns: tuple) -> None:
        query = self.query_one(f"#kb-search-{tab}", Input).value.strip().lower()
        rows = self.rows.get(tab) or []
        table = self.query_one(f"#kb-table-{tab}", DataTable)
        table.clear(columns=True)
        table.add_columns(*columns)
        filtered = [r for r in rows if not query or any(query in str(c).lower() for c in r)]
        shown = [r[: len(columns)] for r in filtered]
        if shown:
            table.add_rows(shown)
        self._display[tab] = filtered
        if tab == "hypr":
            self._hypr_display = filtered
        self.query_one(f"#kb-info-{tab}", Static).update(f"{len(filtered)} of {len(rows)} rows")


