def parse_herdr_combo(combo: str) -> list[str]:
    return [c.strip() for c in combo.split(",") if c.strip()]


def _toml_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _herdr_toml_value(combo_list: list[str], as_array: bool) -> str:
    if as_array or len(combo_list) != 1:
        return "[" + ", ".join(_toml_str(c) for c in combo_list) + "]"
    return _toml_str(combo_list[0])


def herdr_write_change(old_name: str, new_name: str, combo_list: list[str]) -> bool:
    if not HERDR_CONF.exists():
        return False
    lines = HERDR_CONF.read_text().splitlines()
    in_keys = False
    new_lines = []
    found = False
    for line in lines:
        stripped = line.strip()
        if stripped == "[keys]":
            in_keys = True
            new_lines.append(line)
            continue
        if in_keys and stripped.startswith("["):
            in_keys = False
        if in_keys and "=" in line and not stripped.startswith("#"):
            key_name = line.split("=", 1)[0].strip()
            rhs = line.split("=", 1)[1]
            if key_name == old_name:
                as_array = "[" in rhs or len(combo_list) > 1
                new_lines.append(f"{new_name} = {_herdr_toml_value(combo_list, as_array)}")
                found = True
                continue
        new_lines.append(line)
    if not found:
        return False
    backup(HERDR_CONF)
    HERDR_CONF.write_text("\n".join(new_lines).rstrip() + "\n")
    return True


def herdr_write_unbind(name: str) -> bool:
    if not HERDR_CONF.exists():
        return False
    backup(HERDR_CONF)
    lines = HERDR_CONF.read_text().splitlines()
    in_keys = False
    new_lines = []
    for line in lines:
        stripped = line.strip()
        if stripped == "[keys]":
            in_keys = True
            new_lines.append(line)
            continue
        if in_keys and stripped.startswith("["):
            in_keys = False
        if in_keys and "=" in line and not stripped.startswith("#"):
            if line.split("=", 1)[0].strip() == name:
                continue
        new_lines.append(line)
    HERDR_CONF.write_text("\n".join(new_lines).rstrip() + "\n")
    return True


def herdr_write_add(name: str, combo_list: list[str]) -> bool:
    if not HERDR_CONF.exists():
        return False
    backup(HERDR_CONF)
    lines = HERDR_CONF.read_text().splitlines()
    in_keys = False
    new_lines = []
    added = False
    entry = f"{name} = {_herdr_toml_value(combo_list, len(combo_list) > 1)}"
    for line in lines:
        stripped = line.strip()
        if stripped == "[keys]":
            in_keys = True
            new_lines.append(line)
            continue
        if in_keys and stripped.startswith("[") and not added:
            new_lines.append(entry)
            added = True
        new_lines.append(line)
    if not added:
        new_lines.append(entry)
    HERDR_CONF.write_text("\n".join(new_lines).rstrip() + "\n")
    return True


NVIM_MODES = ["n", "v", "i", "x", "s", "o", "t", "c"]
NVIM_SET_RE = re.compile(
    r'vim\.keymap\.set\(\s*["\']([^"\']+)["\']\s*,\s*["\']([^"\']+)["\']\s*,\s*["\'](.*?)["\']'
)


def validate_nvim_mode(mode: str) -> bool:
    return mode in NVIM_MODES


def _nvim_map_line(mode: str, key: str, cmd: str, desc: str) -> str:
    desc_part = f', {{ desc = "{_lua_str(desc)}" }}' if desc else ""
    return f'vim.keymap.set("{_lua_str(mode)}", "{_lua_str(key)}", "{_lua_str(cmd)}"{desc_part})'


def nvim_write_change(old_mode: str, old_key: str, new_mode: str, new_key: str, cmd: str, desc: str) -> bool:
    if not NVIM_KEYMAPS.exists():
        return False
    backup(NVIM_KEYMAPS)
    new_lines = []
    found = False
    for line in NVIM_KEYMAPS.read_text().splitlines():
        m = NVIM_SET_RE.search(line)
        if m and m.group(1) == old_mode and m.group(2) == old_key:
            new_lines.append(_nvim_map_line(new_mode, new_key, cmd, desc))
            found = True
            continue
        new_lines.append(line)
    NVIM_KEYMAPS.write_text("\n".join(new_lines).rstrip() + "\n")
    return found


def nvim_write_unbind(mode: str, key: str) -> bool:
