def hypr_option(name: str):
    raw = sh(["hyprctl", "getoption", name, "-j"])
    if not raw:
        return None
    try:
        data = json.loads(raw)
    except Exception:
        return None
    if "str" in data:
        value = data["str"]
        return "" if value == "[[EMPTY]]" else value
    if "int" in data:
        return int(data["int"])
    if "float" in data:
        return float(data["float"])
    if "bool" in data:
        return bool(data["bool"])
    return None


def read_input_settings() -> dict:
    accel = hypr_option("input:accel_profile") or "adaptive"
    if accel in ("", "[[EMPTY]]"):
        accel = "adaptive"
    return {
        "sensitivity": hypr_option("input:sensitivity") if hypr_option("input:sensitivity") is not None else 0.0,
        "accel_profile": accel,
        "follow_mouse": hypr_option("input:follow_mouse") if hypr_option("input:follow_mouse") is not None else 1,
        "kb_layout": hypr_option("input:kb_layout") or "us",
        "kb_variant": hypr_option("input:kb_variant") or "",
        "kb_options": hypr_option("input:kb_options") or "compose:caps,shift:both_capslock_cancel",
        "repeat_rate": hypr_option("input:repeat_rate") if hypr_option("input:repeat_rate") is not None else 40,
        "repeat_delay": hypr_option("input:repeat_delay") if hypr_option("input:repeat_delay") is not None else 250,
        "numlock_by_default": bool(hypr_option("input:numlock_by_default")),
        "natural_scroll": bool(hypr_option("input:touchpad:natural_scroll")),
        "clickfinger_behavior": bool(hypr_option("input:touchpad:clickfinger_behavior") if hypr_option("input:touchpad:clickfinger_behavior") is not None else True),
        "scroll_factor": hypr_option("input:touchpad:scroll_factor") if hypr_option("input:touchpad:scroll_factor") is not None else 0.4,
        "disable_while_typing": bool(hypr_option("input:touchpad:disable_while_typing") if hypr_option("input:touchpad:disable_while_typing") is not None else True),
    }


def write_input_settings(settings: dict) -> tuple[bool, str]:
    def lua_bool(value: bool) -> str:
        return "true" if value else "false"

    def lua_num(value) -> str:
        if isinstance(value, float) and value.is_integer():
            return str(int(value))
        return str(value)

    block = "\n".join(
        [
            OCC_INPUT_BEGIN,
            "hl.config({",
            "  input = {",
            f'    kb_layout = "{_lua_str(str(settings["kb_layout"]))}",',
            f'    kb_variant = "{_lua_str(str(settings["kb_variant"]))}",',
            f'    kb_options = "{_lua_str(str(settings["kb_options"]))}",',
            f"    repeat_rate = {lua_num(settings['repeat_rate'])},",
            f"    repeat_delay = {lua_num(settings['repeat_delay'])},",
            f"    numlock_by_default = {lua_bool(bool(settings['numlock_by_default']))},",
            f"    follow_mouse = {int(settings['follow_mouse'])},",
            f"    sensitivity = {lua_num(settings['sensitivity'])},",
            f'    accel_profile = "{_lua_str(str(settings["accel_profile"]))}",',
            "    touchpad = {",
            f"      natural_scroll = {lua_bool(bool(settings['natural_scroll']))},",
            f"      clickfinger_behavior = {lua_bool(bool(settings['clickfinger_behavior']))},",
            f"      scroll_factor = {lua_num(settings['scroll_factor'])},",
            f"      disable_while_typing = {lua_bool(bool(settings['disable_while_typing']))},",
            "    },",
            "  },",
            "})",
            OCC_INPUT_END,
            "",
        ]
    )
    existing = HYPR_INPUT.read_text() if HYPR_INPUT.is_file() else ""
    if OCC_INPUT_BEGIN in existing and OCC_INPUT_END in existing:
        body = re.sub(
            re.escape(OCC_INPUT_BEGIN) + r".*?" + re.escape(OCC_INPUT_END),
            block.rstrip(),
            existing,
            count=1,
            flags=re.S,
        )
    else:
        body = existing.rstrip() + "\n\n" + block
    backup(HYPR_INPUT)
    HYPR_INPUT.write_text(body if body.endswith("\n") else body + "\n")
    _out, err, code = run(["hyprctl", "reload"])
    if code != 0:
        return False, err.strip() or "hyprctl reload failed"
    errors = sh(["hyprctl", "configerrors"])
    if errors and errors.strip() not in ("", "ok", "[]"):
        return False, errors.strip()
    return True, "applied"


