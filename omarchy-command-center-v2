def theme_dirs() -> list[dict]:
    result: list[dict] = []
    seen: set[str] = set()

    for base, user in ((CONFIG_DIR / "themes", True), (Path("/usr/share/omarchy/themes"), False)):
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if d.name.startswith(".") or not d.is_dir() or not (d / "colors.toml").is_file():
                continue
            name = d.name
            if name in seen:
                continue
            seen.add(name)
            result.append({"name": name, "dir": d, "user": user})
    return result


def theme_colors(tdir: Path) -> dict:
    path = tdir / "colors.toml"
    if not path.is_file():
        return {}
    try:
        with path.open("rb") as fh:
            return tomllib.load(fh)
    except Exception:
        return {}


def active_theme() -> str:
    out = sh(["omarchy", "theme", "current"])
    return out.splitlines()[0].strip() if out else ""


def theme_names_match(a: str, b: str) -> bool:
    return a.strip().lower().replace(" ", "-") == b.strip().lower()


