def _omarchy_username() -> str:
    return os.environ.get("USER") or getpass.getuser()


def get_cloned_workspaces_plugin_dir() -> Path | None:
    """Return this user's cloned workspaces plugin (`$USER.workspaces`), if any."""
    if not PLUGINS_DIR.is_dir():
        return None
    preferred = PLUGINS_DIR / f"{_omarchy_username()}.workspaces"
    if preferred.is_dir():
        return preferred
    matches = []
    for d in PLUGINS_DIR.iterdir():
        if not d.is_dir() or not d.name.endswith(".workspaces"):
            continue
        cloned_from = ""
        manifest = d / "manifest.json"
        if manifest.is_file():
            try:
                cloned_from = str((json.loads(manifest.read_text()).get("omarchy") or {}).get("clonedFrom") or "")
            except Exception:
                cloned_from = ""
        if cloned_from == "omarchy.workspaces" or d.name.endswith(".workspaces"):
            matches.append(d)
    return sorted(matches, key=lambda p: p.name)[0] if matches else None


def _bar_has_widget(widget_id: str) -> bool:
    layout = (shell_data().get("bar") or {}).get("layout") or {}
    for section in layout.values():
        if not isinstance(section, list):
            continue
        for item in section:
            if item == widget_id:
                return True
            if isinstance(item, dict) and item.get("id") == widget_id:
                return True
    return False


def ensure_named_workspaces_on_bar() -> tuple[bool, str]:
    """Put the cloned workspaces widget on the bar. Do not re-clone if it exists."""
    plugin_dir = get_cloned_workspaces_plugin_dir()
    if plugin_dir:
        install_workspace_names_loader(plugin_dir)
        if _bar_has_widget(plugin_dir.name):
            return True, plugin_dir.name
        _out, err, code = run(["omarchy", "plugin", "enable", plugin_dir.name])
        if code != 0:
            return False, (err or _out).strip() or f"could not enable {plugin_dir.name}"
        return True, plugin_dir.name
    _out, err, code = run(["omarchy", "plugin", "clone", "omarchy.workspaces"])
    if code != 0:
        return False, (err or _out).strip() or "clone failed"
    plugin_dir = get_cloned_workspaces_plugin_dir()
    if not plugin_dir:
        return False, "clone did not create a workspaces plugin"
    return True, plugin_dir.name


def _qml_name_pairs(text: str) -> dict[int, str]:
    labels: dict[int, str] = {}
    for match in re.finditer(r'(\d+)\s*:\s*"((?:[^"\\]|\\.)*)"', text):
        ws_id = int(match.group(1))
        if 1 <= ws_id <= WORKSPACE_SLOT_COUNT:
            labels[ws_id] = match.group(2).replace("\\n", "\n").replace('\\"', '"').replace("\\\\", "\\")
    return labels


def _default_workspace_labels() -> dict[int, str]:
    return {i: str(i) for i in range(1, WORKSPACE_SLOT_COUNT + 1)}


def load_workspace_labels_from_plugin() -> dict[int, str]:
    labels = _default_workspace_labels()
    data = read_json(WORKSPACE_NAMES_JSON)
    if data:
        for key, value in data.items():
            try:
                ws_id = int(key)
            except (TypeError, ValueError):
                continue
            name = str(value).replace("\\", "").strip()
            if 1 <= ws_id <= WORKSPACE_SLOT_COUNT and name:
                labels[ws_id] = name
        return labels
    plugin_dir = get_cloned_workspaces_plugin_dir()
    if not plugin_dir:
        return labels
    qml_file = plugin_dir / "Workspaces.qml"
    if not qml_file.is_file():
        return labels
    content = qml_file.read_text()
    block = None
    named = re.search(r"property var workspaceNames:\s*\(\{(.*?)\}\)", content, flags=re.S)
    if named:
        block = named.group(1)
    else:
        bay = re.search(r"function bayLabel\s*\([^)]*\)\s*\{(.*?)return labels", content, flags=re.S)
        if bay:
            block = bay.group(1)
    if block:
        for ws_id, name in _qml_name_pairs(block).items():
            labels[ws_id] = name.replace("\\", "").strip() or str(ws_id)
    return labels


OCC_NAMES_BEGIN = "// OCC-NAMES-BEGIN"
OCC_NAMES_END = "// OCC-NAMES-END"


def _names_qml_block(labels: dict[int, str]) -> str:
    merged = {i: str(i) for i in range(1, WORKSPACE_SLOT_COUNT + 1)}
    for key, value in labels.items():
        ws_id = int(key)
        name = str(value).replace("\\", "").replace('"', "").strip()
        if 1 <= ws_id <= WORKSPACE_SLOT_COUNT and name:
            merged[ws_id] = name
    lines = [OCC_NAMES_BEGIN, "  property var workspaceNames: ({"]
    for ws_id in range(1, WORKSPACE_SLOT_COUNT + 1):
        lines.append(f'    {ws_id}: "{merged[ws_id]}",')
    lines.append("  })")
    lines.append(OCC_NAMES_END)
    return "\n".join(lines)


def save_workspace_labels_to_plugin(labels: dict[int, str]) -> bool:
    merged = load_workspace_labels_from_plugin()
    for key, value in labels.items():
        ws_id = int(key)
        name = str(value).replace("\\", "").replace('"', "").strip()
        if 1 <= ws_id <= WORKSPACE_SLOT_COUNT and name:
            merged[ws_id] = name
    payload = {str(i): merged[i] for i in range(1, WORKSPACE_SLOT_COUNT + 1)}
    WORKSPACE_NAMES_JSON.parent.mkdir(parents=True, exist_ok=True)
    WORKSPACE_NAMES_JSON.write_text(json.dumps(payload, indent=2) + "\n")
    plugin_dir = get_cloned_workspaces_plugin_dir()
    if not plugin_dir:
        return True
    qml_file = plugin_dir / "Workspaces.qml"
    if not qml_file.is_file():
        return False
    text = qml_file.read_text()
    block = _names_qml_block(merged)
    start = text.find(OCC_NAMES_BEGIN)
    end = text.find(OCC_NAMES_END)
    if start >= 0 and end > start:
        text = text[:start] + block + text[end + len(OCC_NAMES_END) :]
    else:
        needle = "moduleName:"
        at = text.find(needle)
        nl = text.find("\n", at if at >= 0 else 0)
        if nl < 0:
            return False
        text = text[: nl + 1] + "\n" + block + "\n" + text[nl + 1 :]
    qml_file.write_text(text if text.endswith("\n") else text + "\n")
    # Omarchy #8555: Local plugin changed re-registers the widget but
    # Qt.clearComponentCache is not in Quickshell, so the bar keeps the old
    # compiled QML until the shell process restarts.
    run(["omarchy", "restart", "shell"])
    return True


def install_workspace_names_loader(plugin_dir: Path) -> bool:
    qml_file = plugin_dir / "Workspaces.qml"
    if qml_file.is_file() and "workspace-names.json" in qml_file.read_text():
        return True
    if qml_file.is_file():
        backup(qml_file)
    qml_file.write_text(WORKSPACES_QML_TEMPLATE.replace("__MODULE__", plugin_dir.name))
    run(["omarchy-shell", "shell", "rescanPlugins"])
    return True


